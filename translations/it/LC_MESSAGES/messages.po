#: templates/about.html:183
msgid "why_check.solution.constant_monitoring"
msgstr "Controllo quotidiano"

#: templates/about.html:184
msgid "why_check.solution.constant_monitoring_desc"
msgstr ""
"Ogni giorno il servizio confronta la lista dei brani salvati con il catalogo "
